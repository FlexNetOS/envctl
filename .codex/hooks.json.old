{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "sh -lc 'exec /bin/bash /home/flexnetos/FlexNetOS/.codex/hooks/flexnetos-codex-hook.sh session-start'",
            "timeout": 30,
            "statusMessage": "Repo root lifecycle: session start"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "sh -lc 'exec /bin/bash /home/flexnetos/FlexNetOS/.codex/hooks/flexnetos-codex-hook.sh pre-tool-use'",
            "timeout": 30,
            "statusMessage": "Repo root lifecycle: pre tool"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "sh -lc 'exec /bin/bash /home/flexnetos/FlexNetOS/.codex/hooks/flexnetos-codex-hook.sh permission-request'",
            "timeout": 30,
            "statusMessage": "Repo root lifecycle: permission"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "sh -lc 'exec /bin/bash /home/flexnetos/FlexNetOS/.codex/hooks/flexnetos-codex-hook.sh post-tool-use'",
            "timeout": 30,
            "statusMessage": "Repo root lifecycle: post tool"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -lc 'exec /bin/bash /home/flexnetos/FlexNetOS/.codex/hooks/flexnetos-codex-hook.sh user-prompt-submit'",
            "timeout": 30,
            "statusMessage": "Repo root lifecycle: prompt submit"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "sh -lc 'exec /bin/bash /home/flexnetos/FlexNetOS/.codex/hooks/flexnetos-codex-hook.sh pre-compact'",
            "timeout": 30,
            "statusMessage": "Repo root lifecycle: pre compact"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "sh -lc 'exec /bin/bash /home/flexnetos/FlexNetOS/.codex/hooks/flexnetos-codex-hook.sh post-compact'",
            "timeout": 30,
            "statusMessage": "Repo root lifecycle: post compact"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -lc 'exec /bin/bash /home/flexnetos/FlexNetOS/.codex/hooks/flexnetos-codex-hook.sh stop'",
            "timeout": 30,
            "statusMessage": "Repo root lifecycle: stop"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "sh -lc 'exec /bin/bash /home/flexnetos/FlexNetOS/.codex/hooks/flexnetos-codex-hook.sh subagent-start'",
            "timeout": 30,
            "statusMessage": "Repo root lifecycle: subagent start"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "sh -lc 'exec /bin/bash /home/flexnetos/FlexNetOS/.codex/hooks/flexnetos-codex-hook.sh subagent-stop'",
            "timeout": 30,
            "statusMessage": "Repo root lifecycle: subagent stop"
          }
        ]
      }
    ]
  }
}
