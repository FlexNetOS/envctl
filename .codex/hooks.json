{
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "bash '/home/drdave/Desktop/meta/envctl/.codex/hooks/hf-checkpoint.sh'",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "sh -lc 'root=\"$(git rev-parse --show-toplevel)\"; exec rusty-idd next --base \"$root\"'",
            "statusMessage": "Rusty IDD front door: computing the next step",
            "timeout": 180,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "bash '/home/drdave/Desktop/meta/envctl/.codex/hooks/hf-checkpoint.sh'",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}
