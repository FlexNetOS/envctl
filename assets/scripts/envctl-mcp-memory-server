#!/usr/bin/env bash
# MCP memory is provided by the profile-owned ICM server. Envctl does not
# launch a package-manager copy or a file-backed JSON memory store.
set -euo pipefail
export PATH=/usr/bin:/bin

real_home="${ENVCTL_REAL_HOME:-${HOME:-}}"
[ -n "$real_home" ] || {
  printf 'envctl-mcp-memory-server: ENVCTL_REAL_HOME or HOME is required\n' >&2
  exit 1
}
profile="$real_home/.nix-profile"
icm="$profile/bin/icm"
[ -x "$icm" ] || {
  printf 'envctl-mcp-memory-server: profile-owned ICM is unavailable: %s\n' "$icm" >&2
  exit 1
}
exec /usr/bin/env -i HOME="$real_home" PATH="$profile/toolbin:$profile/bin" "$icm" serve
