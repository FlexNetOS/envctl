#!/usr/bin/env bash
# Launch the MCP memory server with every writable path rooted in $META_ROOT.
# The server-memory package honors MEMORY_FILE_PATH; bun/bunx honor the XDG/HOME roots.
set -euo pipefail

if [ -z "${META_ROOT:-}" ]; then
  script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
  candidate="$(cd -- "$script_dir/../../.." && pwd)"
  if [ -f "$candidate/.meta.yaml" ]; then
    export META_ROOT="$candidate"
  elif [ -f /home/drdave/Desktop/meta/.meta.yaml ]; then
    export META_ROOT=/home/drdave/Desktop/meta
  elif [ -f "$HOME/Desktop/meta/.meta.yaml" ]; then
    export META_ROOT="$HOME/Desktop/meta"
  else
    echo "envctl-mcp-memory-server: cannot resolve META_ROOT" >&2
    exit 1
  fi
fi

# For this child process, HOME is the meta-owned home bridge. This prevents npm,
# node, and the MCP server from creating state under the real /home/<user> tree.
export HOME="$META_ROOT/.local"
export XDG_DATA_HOME="$META_ROOT/.local/share"
export XDG_STATE_HOME="$META_ROOT/.local/state"
export XDG_CACHE_HOME="$META_ROOT/.local/cache"
export npm_config_cache="$META_ROOT/.local/cache/npm"
export npm_config_prefix="$META_ROOT/.local"
export MEMORY_FILE_PATH="$META_ROOT/.local/share/mcp-memory/memory.jsonl"
export PATH="$META_ROOT/usr/bin:$META_ROOT/.toolchains/.bun/bin:$META_ROOT/.toolchains/node/bin:$META_ROOT/.local/bin:$PATH"

mkdir -p \
  "$HOME" \
  "$XDG_DATA_HOME/mcp-memory" \
  "$XDG_STATE_HOME" \
  "$XDG_CACHE_HOME/npm"

bunx_bin="$META_ROOT/usr/bin/bunx"
if [ ! -x "$bunx_bin" ]; then
  echo "envctl-mcp-memory-server: missing meta bunx wrapper at $bunx_bin" >&2
  exit 1
fi

exec "$bunx_bin" @modelcontextprotocol/server-memory
