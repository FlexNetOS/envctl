{
  "mcpServers": {
    "context7": {
      "args": [
        "-y",
        "@upstash/context7-mcp@latest"
      ],
      "command": "npx"
    },
    "exa": {
      "url": "https://mcp.exa.ai/mcp"
    },
    "github": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "command": "npx"
    },
    "memory": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "command": "npx"
    },
    "n8n-mcp": {
      "args": [
        "-lc",
        "if [ -z \"${META_ROOT:-}\" ]; then if [ -f \"$HOME/.meta.yaml\" ]; then export META_ROOT=\"$HOME\"; else export META_ROOT=\"$HOME/Desktop/meta\"; fi; fi; export PATH=\"$META_ROOT/.toolchains/.bun/bin:$META_ROOT/.local/bin:$PATH\"; export N8N_API_URL=http://localhost:5678; export N8N_API_KEY=\"$(secretctl secret get n8n-api-key --reveal --apply)\"; exec npx -y n8n-mcp"
      ],
      "command": "bash"
    },
    "playwright": {
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--extension"
      ],
      "command": "npx"
    },
    "sequential-thinking": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "command": "npx"
    }
  }
}
