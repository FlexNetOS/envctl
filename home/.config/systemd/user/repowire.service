# Repowire is a meta-hosted daemon. The shipped unit launches from the canonical
# $META_ROOT/.local tree; the real-home .local path is only the single bridge for
# interactive tools. Re-enable: systemctl --user enable --now repowire.service
[Unit]
Description=Repowire Daemon
After=network.target

[Service]
Type=simple
Environment=META_ROOT=%h/Desktop/meta
ExecStartPre=/usr/bin/install -d -m 700 %h/Desktop/meta/.local/state/repowire
ExecStart=%h/Desktop/meta/usr/bin/repowire serve
Environment=PATH=%h/Desktop/meta/usr/bin:%h/Desktop/meta/.toolchains/cargo/bin:%h/Desktop/meta/.toolchains/.bun/bin:/usr/bin:/bin
Restart=always
RestartSec=5
StandardOutput=append:%h/Desktop/meta/.local/state/repowire/daemon.log
StandardError=append:%h/Desktop/meta/.local/state/repowire/daemon.log

[Install]
WantedBy=default.target
