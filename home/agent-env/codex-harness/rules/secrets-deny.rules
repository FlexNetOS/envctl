# Secret-bearing paths and command previews are forbidden.

prefix_rule(
    pattern = ["cat", "/home/flexnetos/meta/var/lib/codex/auth.json"],
    decision = "forbidden",
    justification = "Codex auth state is secret and must not be read.",
    match = ["cat /home/flexnetos/meta/var/lib/codex/auth.json"],
    not_match = ["cat AGENTS.md"],
)

prefix_rule(
    pattern = ["cat", "/home/flexnetos/.ssh/id_rsa"],
    decision = "forbidden",
    justification = "Private keys are secret and must not be read.",
    match = ["cat /home/flexnetos/.ssh/id_rsa"],
    not_match = ["cat README.md"],
)

prefix_rule(
    pattern = ["sed", "-n", "1,200p", "/home/flexnetos/meta/var/lib/codex/auth.json"],
    decision = "forbidden",
    justification = "Codex auth state is secret and must not be read with sed.",
    match = ["sed -n 1,200p /home/flexnetos/meta/var/lib/codex/auth.json"],
    not_match = ["sed -n 1,20p AGENTS.md"],
)
