# Network calls require explicit profile/owner proof.

prefix_rule(
    pattern = [["curl", "wget"]],
    decision = "prompt",
    justification = "Network fetches require explicit task scope and no secret output.",
    match = ["curl https://openrouter.ai/api/v1/models", "wget https://example.com"],
    not_match = ["rg curl"],
)

prefix_rule(
    pattern = ["curl", "https://openrouter.ai/api/v1/responses"],
    decision = "forbidden",
    justification = "Direct OpenRouter Responses calls must use codex-harness-openrouter-shim.",
    match = ["curl https://openrouter.ai/api/v1/responses"],
    not_match = ["codex-harness-openrouter-shim probe"],
)

prefix_rule(
    pattern = ["gh", ["api", "pr", "issue", "repo", "run", "workflow"]],
    decision = "prompt",
    justification = "GitHub network access must be explicit and is mediated by github guard for mutations.",
    match = ["gh pr list", "gh api repos/OWNER/REPO"],
    not_match = ["git status --short"],
)
