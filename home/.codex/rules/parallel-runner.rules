# Parallel/background work must go through the Rust harness runner.

prefix_rule(
    pattern = [["tmux", "screen", "nohup", "setsid"]],
    decision = "forbidden",
    justification = "Background sessions must be supervised by codex-harness-runner.",
    match = ["tmux new -d sleep 99", "nohup sleep 99", "setsid sleep 99"],
    not_match = ["codex-harness-runner spawn -- sleep 1"],
)

prefix_rule(
    pattern = [["bash", "sh", "zsh"], ["-lc", "-c"]],
    decision = "prompt",
    justification = "Shell wrapper commands can hide compound behavior; hooks and runner policy must inspect them.",
    match = ["bash -lc pwd", "sh -c 'git status --short'"],
    not_match = ["pwd"],
)

prefix_rule(
    pattern = ["codex", ["exec", "review", "resume", "fork", "cloud"]],
    decision = "forbidden",
    justification = "Nested Codex agent lanes must be supervised by codex-harness-runner.",
    match = ["codex exec hello", "codex review", "codex resume --last"],
    not_match = ["codex --version", "codex features list", "codex mcp list"],
)

prefix_rule(
    pattern = ["rtk", "codex", ["exec", "review", "resume", "fork", "cloud"]],
    decision = "forbidden",
    justification = "RTK does not bypass the requirement that nested Codex lanes use codex-harness-runner.",
    match = ["rtk codex exec hello", "rtk codex review"],
    not_match = ["rtk codex --version"],
)

prefix_rule(
    pattern = ["claude", ["--print", "-p", "--background", "--bg", "agents"]],
    decision = "forbidden",
    justification = "Claude agent lanes must be supervised by codex-harness-claude-bridge.",
    match = ["claude --print hello", "claude --background", "claude agents list"],
    not_match = ["claude --version"],
)

prefix_rule(
    pattern = ["rtk", "claude", ["--print", "-p", "--background", "--bg", "agents"]],
    decision = "forbidden",
    justification = "RTK-routed Claude agent lanes must still use the supervised harness bridge.",
    match = ["rtk claude --print hello", "rtk claude --background"],
    not_match = ["rtk claude --version"],
)

prefix_rule(
    pattern = ["ollama", ["run", "pull", "serve"]],
    decision = "forbidden",
    justification = "Ollama model execution and pulls must be supervised by codex-harness-runner.",
    match = ["ollama run llama3", "ollama pull llama3", "ollama serve"],
    not_match = ["ollama list"],
)

prefix_rule(
    pattern = ["codex-harness-runner"],
    decision = "allow",
    justification = "The Rust harness runner is the supervised background execution path.",
    match = ["codex-harness-runner policy-check -- pwd"],
    not_match = ["codex exec hello"],
)
