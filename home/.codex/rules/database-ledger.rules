# Ledgers and databases are append/indexed through sanctioned harness binaries only.

prefix_rule(
    pattern = [["sqlite3"]],
    decision = "forbidden",
    justification = "Direct SQLite mutation/inspection of harness DB is forbidden; use codex-harness-db.",
    match = ["sqlite3 state/harness.sqlite3 .tables"],
    not_match = ["codex-harness-db integrity"],
)

prefix_rule(
    pattern = [["tee", ">", ">>"]],
    decision = "prompt",
    justification = "Direct writes may bypass JSONL hash chain; use sanctioned ledger append where applicable.",
    match = ["tee ledger/harness.jsonl", ">> ledger/harness.jsonl"],
    not_match = ["codex-harness-runner ledger-append --ledger harness.jsonl -- '{}'"],
)

prefix_rule(
    pattern = [["codex-harness-db", "/home/flexnetos/meta/src/envctl/home/agent-env/codex-harness/target/debug/codex-harness-db"]],
    decision = "allow",
    justification = "Harness DB binary is the sanctioned SQLite path.",
    match = ["codex-harness-db integrity", "/home/flexnetos/meta/src/envctl/home/agent-env/codex-harness/target/debug/codex-harness-db integrity"],
    not_match = ["sqlite3 state/harness.sqlite3"],
)
