# The owner-approved full-access prompt requires this explicit Codex launch
# surface. Archive-first, secret-deny, destructive-action, and GitHub guard
# rules remain authoritative; the broad execution context is not itself a
# policy violation.

prefix_rule(
    pattern = ["codex", "--dangerously-bypass-approvals-and-sandbox"],
    decision = "allow",
    justification = "Operator full-access decision USER-FULL-ACCESS-20260709 authorizes the prompt frontdoor.",
    match = ["codex --dangerously-bypass-approvals-and-sandbox"],
    not_match = ["codex --version"],
)

prefix_rule(
    pattern = ["codex", "exec", "--dangerously-bypass-approvals-and-sandbox"],
    decision = "allow",
    justification = "Full-access verification lanes are permitted through the supervised harness runner.",
    match = ["codex exec --dangerously-bypass-approvals-and-sandbox hi"],
    not_match = ["codex exec hi"],
)

prefix_rule(
    pattern = ["codex", "-s", "danger-full-access"],
    decision = "allow",
    justification = "The tracked operator decision makes danger-full-access execution context, not a gate.",
    match = ["codex -s danger-full-access"],
    not_match = ["codex -s read-only"],
)
