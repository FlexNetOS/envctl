# Nested agent/provider launches must be routed and supervised.

prefix_rule(
    pattern = ["codex", ["exec", "review", "cloud"]],
    decision = "forbidden",
    justification = "Nested Codex execution requires codex-harness-runner and model-router decision.",
    match = ["codex exec hi", "codex review"],
    not_match = ["codex --version"],
)

prefix_rule(
    pattern = ["claude", ["--print", "-p", "--background", "--bg"]],
    decision = "forbidden",
    justification = "Direct Claude execution requires codex-harness-claude-bridge.",
    match = ["claude --print hi", "claude --background"],
    not_match = ["claude --version"],
)

prefix_rule(
    pattern = ["ollama", ["run", "pull", "serve"]],
    decision = "forbidden",
    justification = "Local model execution/pulls require codex-harness-runner.",
    match = ["ollama run llama3", "ollama pull llama3"],
    not_match = ["ollama list"],
)
