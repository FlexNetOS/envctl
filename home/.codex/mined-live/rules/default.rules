prefix_rule(pattern=["nix", "develop", "--accept-flake-config", ".#ci", "-c", "br", "create", "Automate local-source Yazelix runtime refresh", "--type", "task", "--priority", "1", "--description", "Add a no-human-in-loop update command for profile-owned local-source Yazelix installs. It should detect active default-profile entries sourced from a local checkout, build/upgrade the matching entries together, refuse Home Manager/non-local owners, and run generated-state repair through the upgraded profile yzx so stale files update without downgrade.", "--acceptance", "1. A public yzx update subcommand exists for local-source installs. 2. It only runs for active default-profile entries whose URL is local source (git+file/path/file), including multiple entries that share the active runtime. 3. It upgrades those entries together and runs generated-state repair through the upgraded profile yzx. 4. It rejects Home Manager/non-local/unmanaged installs with owner-specific guidance. 5. Focused parser/detection tests cover the new trigger policy."], decision="allow")
