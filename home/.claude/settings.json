{
  "model": "claude-fable-5[1m]",
  "effort": "high",
  "tui": "fullscreen",
  "theme": "dark",
  "skipWorkflowUsageWarning": true,
  "teammateMode": "tmux",
  "autoMemoryDirectory": "/home/flexnetos/lifeos/var/lib/claude-harness/memory",
  "cleanupPeriodDays": 30,
  "env": {
    "HARNESS_VAR": "/home/flexnetos/lifeos/var",
    "ENABLE_TOOL_SEARCH": "auto",
    "MAX_MCP_OUTPUT_TOKENS": "25000",
    "SECURITY_WARNINGS_STATE_DIR": "/home/flexnetos/FlexNetOS/var/lib/claude-harness/security",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "sandbox": {
    "enabled": false
  },
  "enabledPlugins": {
    "security-guidance@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.credentials.json)",
      "Read(~/.ssh/**)",
      "Read(**/secrets/**)",
      "Edit(//home/flexnetos/lifeos/var/log/claude-harness/**)",
      "Write(//home/flexnetos/lifeos/var/log/claude-harness/**)",
      "Edit(~/.claude/archive/**)",
      "Write(~/.claude/archive/**)",
      "Bash(claude -p:*)",
      "Bash(claude --bg:*)",
      "Bash(claude agents:*)"
    ],
    "ask": [
      "Agent(model:opus)",
      "Agent(model:sonnet)",
      "Agent(model:haiku)",
      "Bash(git push:*)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/hooks/statusline.sh",
    "refreshInterval": 5
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "\"$HOME\"/.claude/hooks/session-start.sh", "timeout": 10 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"$HOME\"/.claude/hooks/guard-bash.sh", "timeout": 10 }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          { "type": "command", "command": "\"$HOME\"/.claude/hooks/guard-agent-spawn.sh", "timeout": 10 }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "\"$HOME\"/.claude/hooks/guard-write-paths.sh", "timeout": 10 },
          { "type": "command", "command": "\"$HOME\"/.claude/hooks/grit-advise.sh", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "\"$HOME\"/.claude/hooks/rust-postedit.sh", "async": true }
        ]
      },
      {
        "matcher": "Agent|Bash",
        "hooks": [
          { "type": "command", "command": "\"$HOME\"/.claude/hooks/budget-sentinel.sh", "async": true }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          { "type": "command", "command": "\"$HOME\"/.claude/hooks/spawn-ledger.sh", "timeout": 10 }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "\"$HOME\"/.claude/hooks/spawn-ledger.sh", "timeout": 10 }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          { "type": "command", "command": "\"$HOME\"/.claude/hooks/spawn-ledger.sh", "timeout": 10 }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          { "type": "command", "command": "\"$HOME\"/.claude/hooks/spawn-ledger.sh", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"$HOME\"/.claude/hooks/stop-decision-gate.sh", "timeout": 10 }
        ]
      }
    ],
    "ConfigChange": [
      {
        "hooks": [
          { "type": "command", "command": "\"$HOME\"/.claude/hooks/config-audit.sh", "timeout": 10 }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "agent_needs_input|agent_completed|permission_prompt|idle_prompt",
        "hooks": [
          { "type": "command", "command": "\"$HOME\"/.claude/hooks/notify-cosmic.sh", "timeout": 10 }
        ]
      }
    ]
  }
}
