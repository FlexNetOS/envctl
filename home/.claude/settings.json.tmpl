{
  "model": "claude-fable-5[1m]",
  "effort": "high",
  "tui": "fullscreen",
  "theme": "dark",
  "skipWorkflowUsageWarning": true,
  "teammateMode": "tmux",
  "autoMemoryDirectory": "/home/flexnetos/meta/var/lib/claude-harness/memory",
  "cleanupPeriodDays": 30,
  "env": {
    "HARNESS_VAR": "/home/flexnetos/meta/var",
    "ENABLE_TOOL_SEARCH": "auto",
    "MAX_MCP_OUTPUT_TOKENS": "25000",
    "SECURITY_WARNINGS_STATE_DIR": "/home/flexnetos/meta/var/lib/claude-harness/security",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "AGENTDB_PATH": "/home/flexnetos/meta/var/lib/agentdb/reasoningbank.db",
    "AGENTDB_RUNTIME": "/home/flexnetos/meta/var/lib/agentdb/runtime",
    "AGENTDB_ENABLED": "true",
    "AGENTDB_LEARNING": "true",
    "AGENTDB_REASONING": "true",
    "AGENTDB_QUANTIZATION": "scalar",
    "AGENTDB_CACHE_SIZE": "2000",
    "AGENTDB_HNSW_M": "16",
    "AGENTDB_HNSW_EF": "100",
    "RUVECTOR_INTEL_ROOT": "/home/flexnetos/meta/src/meta-ruvector"
  },
  "sandbox": {
    "enabled": false
  },
  "enabledPlugins": {
    "security-guidance@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.credentials.json)",
      "Read(~/.ssh/**)",
      "Read(**/secrets/**)",
      "Edit(//home/flexnetos/meta/var/log/claude-harness/**)",
      "Write(//home/flexnetos/meta/var/log/claude-harness/**)",
      "Edit(~/.claude/archive/**)",
      "Write(~/.claude/archive/**)",
      "Bash(claude -p:*)",
      "Bash(claude --bg:*)",
      "Bash(claude agents:*)"
    ],
    "ask": [
      "Agent(model:opus)",
      "Agent(model:sonnet)",
      "Agent(model:haiku)",
      "Bash(git push:*)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/hooks/statusline.sh",
    "refreshInterval": 5
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/session-start.sh",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/ccbrain-session-start.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/guard-bash.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/block-cherry-pick.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/bun-rewrite.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/guard-agent-spawn.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/guard-write-paths.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/grit-advise.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/bash-to-nu.py",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/rust-postedit.sh",
            "async": true
          },
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/ruvector-intel-bridge.sh post-edit",
            "async": true
          }
        ]
      },
      {
        "matcher": "Agent|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/budget-sentinel.sh",
            "async": true
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/ruvector-intel-bridge.sh post-bash",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/ruvector-intel-bridge.sh route",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/ruvector-intel-bridge.sh session-end",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/spawn-ledger.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/spawn-ledger.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/spawn-ledger.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/spawn-ledger.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/stop-decision-gate.sh",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/ccbrain-session-stop.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/config-audit.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "agent_needs_input|agent_completed|permission_prompt|idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.claude/hooks/notify-cosmic.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}