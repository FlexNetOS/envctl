{
  "model": "claude-fable-5[1m]",
  "effort": "high",
  "tui": "fullscreen",
  "theme": "dark",
  "skipWorkflowUsageWarning": true,
  "teammateMode": "tmux",
  "autoMemoryDirectory": "/home/flexnetos/meta/var/lib/claude-harness/memory",
  "cleanupPeriodDays": 30,
  "env": {
    "HARNESS_VAR": "/home/flexnetos/meta/var",
    "ENABLE_TOOL_SEARCH": "auto",
    "MAX_MCP_OUTPUT_TOKENS": "25000",
    "SECURITY_WARNINGS_STATE_DIR": "/home/flexnetos/meta/var/lib/claude-harness/security",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "AGENTDB_PATH": "/home/flexnetos/meta/var/lib/agentdb/reasoningbank.db",
    "AGENTDB_RUNTIME": "/home/flexnetos/meta/var/lib/agentdb/runtime",
    "AGENTDB_ENABLED": "true",
    "AGENTDB_LEARNING": "true",
    "AGENTDB_REASONING": "true",
    "AGENTDB_QUANTIZATION": "scalar",
    "AGENTDB_CACHE_SIZE": "2000",
    "AGENTDB_HNSW_M": "16",
    "AGENTDB_HNSW_EF": "100",
    "RUVECTOR_INTEL_ROOT": "/home/flexnetos/meta/src/meta-ruvector"
  },
  "sandbox": {
    "enabled": false
  },
  "enabledPlugins": {
    "security-guidance@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.credentials.json)",
      "Read(~/.ssh/**)",
      "Read(**/secrets/**)",
      "Edit(//home/flexnetos/meta/var/log/claude-harness/**)",
      "Write(//home/flexnetos/meta/var/log/claude-harness/**)",
      "Edit(~/.claude/archive/**)",
      "Write(~/.claude/archive/**)",
      "Bash(claude -p:*)",
      "Bash(claude --bg:*)",
      "Bash(claude agents:*)"
    ],
    "ask": [
      "Agent(model:opus)",
      "Agent(model:sonnet)",
      "Agent(model:haiku)",
      "Bash(git push:*)"
    ],
    "disableBypassPermissionsMode": "disable",
    "defaultMode": "auto"
  },
  "effortLevel": "high"
}
