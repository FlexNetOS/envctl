{
  "commit": {"author":"drdave <flexnetos@de-flex.net>","changes":[{"change_type":"modified","content_hash":"bdb9105f2aeea09f400ad2bc160aeb393f2f4c580ce926f20ab930fe20ee64e5","doc_type":"incident","document_id":"019f2a52-3abb-79a3-b941-73f974623260","hunks":[{"lines":[{"content":"## Root Cause","op":"add"},{"content":"","op":"add"},{"content":"`manifest/components.d/codex-global-baseline.toml` still modeled the","op":"add"},{"content":"pre-cleanroom Codex hook bundle as active desired state. It required generated","op":"add"},{"content":"`hooks.json`, enabled `[features].hooks = true`, wrote lifecycle hooks with the","op":"add"},{"content":"old `with-meta-env.sh` helper, and verified that helper.","op":"add"},{"content":"","op":"add"},{"content":"That made manual hook purges non-durable: any envctl detect/install/verify","op":"add"},{"content":"repair path could reintroduce the corrupted hook state.","op":"add"},{"content":"","op":"add"},{"content":"## Repair","op":"add"},{"content":"","op":"add"},{"content":"The envctl baseline now:","op":"add"},{"content":"","op":"add"},{"content":"- Accepts `LIFEOS_ROOT` first, with `META_ROOT` retained only as a compatibility","op":"add"},{"content":"  fallback.","op":"add"},{"content":"- Removes active lifecycle hook generation and pre-cleanroom hook-helper checks.","op":"add"},{"content":"- Pins `[features].hooks = false` until a clean-room lifecycle gate is rebuilt.","op":"add"},{"content":"- Unlinks stale generated `~/.codex/hooks.json` during install.","op":"add"},{"content":"- Adds a regression guard in","op":"add"},{"content":"  `scripts/tests/test-flexnetos-codex-runtime-gate.sh`.","op":"add"},{"content":"","op":"add"},{"content":"Hooks remain mandatory for the control plane. The removed bundle was the","op":"add"},{"content":"corrupted pre-cleanroom implementation, not the future clean-room hook policy.","op":"add"},{"content":"","op":"add"},{"content":"## Evidence","op":"add"},{"content":"","op":"add"},{"content":"Archive before mutation:","op":"add"},{"content":"","op":"add"},{"content":"```text","op":"add"},{"content":"/home/flexnetos/FlexNetOS/var/lib/codex-runtime-gate/archives/envctl-pre-cleanroom-hook-generator-before-20260703T233100Z.tar.gz","op":"add"},{"content":"sha256: 2f3122f94d847314886fe1999b8cf6da07c8104b2c651f421b25ac6ff9502ec5","op":"add"},{"content":"```","op":"add"},{"content":"","op":"add"},{"content":"Proof commands:","op":"add"},{"content":"","op":"add"},{"content":"```text","op":"add"},{"content":"bash scripts/tests/test-flexnetos-codex-runtime-gate.sh","op":"add"},{"content":"PASS: FlexNetOS Codex runtime gate is archived, inactive, and generator-disabled","op":"add"},{"content":"","op":"add"},{"content":"/home/flexnetos/FlexNetOS/usr/bin/envctl lock --check","op":"add"},{"content":"envctl.lock matches the manifest (97 components)","op":"add"},{"content":"","op":"add"},{"content":"codex features list","op":"add"},{"content":"hooks stable false","op":"add"},{"content":"```","op":"add"}],"new_count":46,"new_start":1,"old_count":0,"old_start":1}],"metadata_changes":[{"field":"type","new_value":"incident","old_value":"incident"}],"new_version":2,"previous_commit_id":"019f2a56-7b8d-7970-927f-3b75a951d8b1","previous_hash":"26871620d5a9bd6ff36fef6102be60f02b7a771ebbe1c515dbbdda99f39475a7","previous_version":1,"slug":"retire-broken-pre-cleanroom-codex-hook-baseline","title":"Retire broken pre-cleanroom Codex hook baseline"}],"created_at":"2026-07-03T23:36:05.660710570Z","id":"019f2a56-e524-74a3-a034-3a3cc2473e3f","message":"Document pre-cleanroom hook baseline retirement"},
